      "Bash(yay -Q:*)",
      "Bash(yay -Ss:*)",
      "Bash(podman run:*)",
      "Bash(podman build:*)",
      "Bash(podman kill:*)",
      "Bash(podman ps:*)",
      "Bash(podman images:*)",
      "Bash(podman inspect:*)",
      "Bash(podman logs:*)",
      "Bash(podman compose:*)",
      "Bash(podman compose:*)",
      "Bash(cargo build:*)",
