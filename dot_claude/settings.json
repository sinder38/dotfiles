      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv pip:*)",
      "Bash(uv --version)",
      "Bash(pipx list:*)",
      "Bash(pipx run:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go run:*)",
      "Bash(go vet:*)",
      "Bash(go mod:*)",
      "Bash(go get:*)",
      "Bash(go install:*)",
      "Bash(go version)",
      "Bash(mvn compile:*)",
      "Bash(mvn test:*)",
      "Bash(mvn package:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn --version)",
      "Bash(gradle build:*)",
      "Bash(gradle test:*)",
      "Bash(gradle check:*)",
      "Bash(gradle --version)",
      "Bash(tee /tmp/claude-*)",
      "Bash(cat /tmp/claude-*)",
      "Bash(rm /tmp/claude-*)",
      "Bash(mkdir -p /tmp/claude-*)",
      "Read(/tmp/claude-*)",
      "Write(/tmp/claude-*)",
      "Edit(/tmp/claude-*)"

    ],
    "deny": [
      "Bash(git commit)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)"
    ]
  },
  "cleanupPeriodDays": 60,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "gitlab.com",
        "crates.io",
        "*.crates.io",
        "proxy.golang.org",
        "sum.golang.org",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // \"Claude needs your attention\"' | { read -r msg; notify-send -u normal -i dialog-information \"Claude Code\" \"$msg\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false
}
