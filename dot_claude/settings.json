      "Bash(cargo --version)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm list:*)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(npm audit:*)",
      "Bash(npm --version)",
      "Bash(yarn install:*)",
      "Bash(yarn add:*)",
      "Bash(yarn run:*)",
      "Bash(yarn build:*)",
      "Bash(yarn test:*)",
      "Bash(yarn --version)",
      "Bash(pip install:*)",
      "Bash(pip list:*)",
      "Bash(pip show:*)",
      "Bash(pip freeze:*)",
